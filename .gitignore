.env

# Server state written by scripts/deploy.sh: current image tags and the deploy lock.
versions.env
.deploy.lock

# TLS material and ACME tokens live only on the server; the empty directories are kept
# so the gateway bind mounts exist everywhere (otherwise Docker creates them as root).
certs/*
!certs/.gitkeep
acme/*
!acme/.gitkeep

# Terraform: state holds the data of every resource (and can hold secrets), providers are
# downloaded by `terraform init`. .terraform.lock.hcl IS committed: it pins provider versions.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

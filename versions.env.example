# Image tags currently running on the server. Copy to versions.env once (cp versions.env.example
# versions.env) and set the tags that are live now; after that only scripts/deploy.sh writes it.
# Format: sha-<first 7 chars of the commit>, as published by CI (docker/metadata-action type=sha).
# Locally, keep BACKEND_TAG / FRONTEND_TAG in .env instead (see .env.example).
BACKEND_TAG=
FRONTEND_TAG=

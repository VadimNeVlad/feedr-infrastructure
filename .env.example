POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

JWT_SECRET=secret
CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret

# Where the gateway is published on the host (default: 127.0.0.1:8080, local only).
# On the VPS: GATEWAY_PUBLISH=80 (all interfaces, IPv4 + IPv6).
# GATEWAY_PUBLISH=80

# HTTPS (VPS only). Default 127.0.0.1:8443 — nothing listens there with gateway.conf.
# GATEWAY_PUBLISH_TLS=443
# nginx config: gateway.conf (plain HTTP, local and TLS bootstrap) or gateway.tls.conf
# (needs certs/ from certbot — switch only after the first certificate is issued).
# GATEWAY_CONF=gateway.tls.conf

# Image tags from GHCR: sha-<first 7 chars of commit>. Locally with compose.build.yaml: local
# On the server tags live in versions.env (written by scripts/deploy.sh) — remove them from .env there.
BACKEND_TAG=local
FRONTEND_TAG=local
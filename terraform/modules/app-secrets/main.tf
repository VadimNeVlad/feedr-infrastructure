# Secrets that belong to one environment and are generated, not provided by a person.
# Created and destroyed together with the environment.

# The value is generated by an ephemeral resource and written with a write-only argument
# (`secret_string_wo`): it exists only while `apply` runs and is never stored in the Terraform
# state or plan. Classic `random_password` + `secret_string` would leave it in the state in clear text.
ephemeral "random_password" "jwt" {
  length  = 64
  special = false
}

# Accepted (trivy AWS-0098): AWS managed key aws/secretsmanager instead of a customer KMS key.
#trivy:ignore:AWS-0098
resource "aws_secretsmanager_secret" "jwt" {
  name        = "feedr/${var.environment}/jwt"
  description = "JWT signing secret of the FeedR backend in ${var.environment}. Generated by Terraform."

  # The environment is destroyed after every test run; with a recovery window the name would be
  # blocked for days and the next `apply` would fail. A lost JWT secret only logs everyone out.
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id        = aws_secretsmanager_secret.jwt.id
  secret_string_wo = ephemeral.random_password.jwt.result

  # Write-only values can't be compared with what's stored, so Terraform writes a new one only
  # when this number changes. Rotation: bump jwt_secret_version and apply.
  secret_string_wo_version = var.jwt_secret_version
}
